modules = ["nodejs-20", "python-3.12", "lua-5.2", "java-graalvm22.3", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5001

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 80

[userenv]

[userenv.shared]

[userenv.development]
APP_URL = "https://66152dca-4f8c-41b2-b41e-e4bff91b1c17-00-3ooefx2hctsjj.worf.replit.dev"
EMAIL_FROM = "onboarding@resend.dev"

[userenv.production]
APP_URL = "https://coding-question-automation.replit.app/"
EMAIL_FROM = "onboarding@resend.dev"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm start"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
