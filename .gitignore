# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# next.js
/.next/
/out/
/graphify-out
# production
/build
pipeline/graphify-out/
scripts/com.user.cp-auto-resume.plist
scripts/cp-auto-resume.sh

/file-handling-q1
/file-handling-problems
.gitignore

pipeline/QUALITY_AUDIT.md

# misc
.DS_Store
*.pem
.local-object-storage/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but track the committed template (single source of truth for all env vars)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — local settings stay private, shared skills are committed.
# `.claude/*` (not `.claude/`) is required: git cannot re-include a path whose
# parent directory is excluded, so a bare `!.claude/skills/` would do nothing.
.claude/*
!.claude/skills/

# python build artifacts
*.pyc
__pycache__/
.venv/

# pipeline runtime / generated workspaces (per-problem Inputs/Outputs, usage counters)
pipeline/problems/
pipeline/temp_compiler_sandbox/

# The scratch problem slot. pipeline/Inputs holds whichever single problem is being
# prepared right now, so it changes on every run and belongs to nobody.
# topics_list.txt is NOT scratch: it is a shared reference input that
# createTempWorkspace copies into every run's workspace, so it stays tracked. Ignoring
# the whole directory would leave a fresh clone unable to generate topics.
pipeline/Inputs/problem.md
pipeline/Inputs/solution.*

# Everything the pipeline generates. Regenerated from Inputs on every run, so a
# checked-in copy is only ever someone else's leftover state.
pipeline/Outputs/*
!pipeline/Outputs/.gitkeep

# stray working notes
/clear picture.md
/backups/
.npmrc.local

# personal quick-ref duplicate (canonical guide is docs/local-setup.md)
LOCAL_SETUP.md

# replit export/import tooling (outputs under /backups/)
scripts/export-replit-db.mts
scripts/export-replit-storage.mts
scripts/import-db.mts

# local freelancer prompt kit and export artifacts
/dist/
/pipeline/freelancer_kit/
/scripts/export-freelancer-kit.py
/pipeline/Scripts/tests/test_freelancer_kit.py
/freelancer-function-practice/
/freelancer-function-practice.zip

# drizzle-kit scratch output. This repo uses `push`, not generate/migrate, so nothing
# here is a source artifact — it only appears when someone runs the CLI.
drizzle/
.tmp-q1fix2/
file-handling-cpp/
.tmp-medium/
.tmp-mediumhard/
.tmp-hard/
.tmp-q1expand/
file-handling-q1/
file-handling-medium/
file-handling-problems/
file-handling-hard/
file-handling-mediumhard/

# Google service account key (Loadings / Sheets API)
service-account.json

# Ad-hoc analysis output, not part of the app
Claude outputs/

# Has no effect while .gitignore is tracked (git ignores only untracked paths).
# Kept because it was asked for; to actually stop sharing this file you would
# need `git rm --cached .gitignore`, which deletes it for every other clone.
# For rules you want local-only, use .git/info/exclude instead.
.gitignore
