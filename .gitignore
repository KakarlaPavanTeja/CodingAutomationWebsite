# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# next.js
/.next/
/out/
/graphify-out
# production
/build

# misc
.DS_Store
*.pem
.local-object-storage/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/

# python build artifacts
*.pyc
__pycache__/
.venv/

# pipeline runtime / generated workspaces (per-problem Inputs/Outputs, usage counters)
pipeline/problems/
pipeline/Outputs/usage_tracker.json
pipeline/temp_compiler_sandbox/

# stray working notes
/clear picture.md
scripts/team-secrets.env
/backups/
.npmrc.local

# personal quick-ref duplicate (canonical guide is docs/local-setup.md)
LOCAL_SETUP.md

# replit export/import tooling (outputs under /backups/)
scripts/export-replit-db.mts
scripts/export-replit-storage.mts
scripts/import-db.mts

