###############################################################################
# Coding Automation Website — environment template
#
# HOW TO USE
#   Next.js app:  cp .env.example .env.local   (then fill in the REQUIRED vars)
#   Production:   put the same keys in .env.production
#   Python pipeline reads the process env it inherits from the Next.js app, plus
#   its own files: pipeline/.env.execution_manager_v2 (AWS/S3) and
#   pipeline/.env.new_compiler.local (compiler service). See those sections below.
#
# Everything under a "REQUIRED" heading must be set. Commented lines (#KEY=...)
# are OPTIONAL overrides shown with their built-in default — uncomment to change.
# NEVER commit a filled-in .env.local / .env.production (all .env* are gitignored).
###############################################################################


# =============================================================================
# REQUIRED — core
# =============================================================================

# Postgres connection string (Neon in production; local Postgres in dev).
DATABASE_URL=postgresql://user:pass@localhost:5432/coding_automation

# Overrides DATABASE_URL for `npm run db:push` / `db:studio` ONLY (drizzle.config.ts
# loads .env.local with override:true, so a DATABASE_URL= prefix is ignored). Set this
# to point drizzle-kit at anything other than the DB .env.local names.
# DRIZZLE_DATABASE_URL=

# Postgres pool size, default 10. Lower it to run a second app instance (a worktree
# dev server) against the same DB without exhausting its connection slots.
# PG_POOL_MAX=10

# OpenRouter API key for all LLM calls (pipeline + CP prep). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Previous OpenRouter key, kept so the admin key screen can report/fall back to it
# during a rotation (src/lib/openrouter-key.ts).
# OPENROUTER_API_KEY_OLD=

# Shared secret guarding internal/cron callbacks (admin cleanup, llm-usage,
# pipeline internal API). Use a long random hex string.
CRON_SECRET=change-me-internal-callback-secret


# =============================================================================
# App / auth
# =============================================================================

PORT=5001
APP_URL=http://localhost:5001
NEXT_PUBLIC_APP_URL=http://localhost:5001
INTERNAL_API_URL=http://127.0.0.1:5001

# Extra hosts allowed to reach the dev server (next.config.ts allowedDevOrigins).
# ngrok/cloudflare wildcards and 172.16.*.* are already allowed by default.
# NGROK_DOMAIN=                       # single tunnel host
# ALLOWED_DEV_ORIGINS=                # comma-separated extra hosts
# NEXTAUTH_URL=http://localhost:5001

# Only needed to self-register a NEW admin at signup. Existing accounts work
# without it. Leave blank otherwise.
ADMIN_SECRET_KEY=


# =============================================================================
# Email (optional — password reset / notifications via Resend)
# =============================================================================

RESEND_API_KEY=
EMAIL_FROM=


# =============================================================================
# Object storage (Next.js app — src/lib/object-storage.ts)
#   Backend priority: AWS S3  ->  GCS (Replit)  ->  local disk.
# =============================================================================

# --- AWS S3 (preferred; shared team bucket). Active ONLY when all four of
#     KEY_ID + SECRET + REGION + BUCKET_NAME are set. Uploaded files are
#     namespaced under AWS_OBJECT_KEY_PREFIX.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=
AWS_OBJECT_KEY_PREFIX=testing-coding-question-test-cases/CodingAutomationData/

# --- GCS / Replit App Storage (used when S3 is not configured).
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# --- Local filesystem fallback (used when neither S3 nor GCS is configured).
LOCAL_OBJECT_STORAGE_ROOT=.local-object-storage


# =============================================================================
# Pipeline paths & sync (optional overrides — sane defaults if unset)
# =============================================================================

PYTHON_PATH=python3
# PIPELINE_ROOT=                      # defaults to <cwd>/pipeline
# PIPELINE_SCRIPTS_DIR=               # defaults to <PIPELINE_ROOT>/Scripts
# PIPELINE_REFERENCE_DIR=
# PIPELINE_SHARED_INPUTS_DIR=
# PIPELINE_INTERNAL_LOOPBACK=1        # 0 to disable 127.0.0.1 loopback callback
# PIPELINE_OUTPUT_SYNC_MS=30000       # how often outputs are flushed to storage
# PIPELINE_LOG_SYNC_MS=12000          # how often logs are flushed
# PIPELINE_SYNC_MAX_FILE_BYTES=       # skip syncing files larger than this
# FILE_SAVE_MAX_BYTES=                # per-file upload cap for the files API


# =============================================================================
# Pipeline behavior (optional)
# =============================================================================

# PIPELINE_ENABLED_LANGS=             # e.g. python,java,cpp,javascript
# PIPELINE_DEFAULT_TAGS=
# PIPELINE_GENERATE_TITLE_WITH_AI=    # 1 to let the LLM generate the title
# PIPELINE_MAX_WRONG_SOLUTIONS=

# 1 to skip flushing pipeline outputs/logs to object storage (local-only runs).
# PIPELINE_SKIP_CLOUD_SYNC=
# Testcase quality gate B1 (pipeline/Scripts/testcase_annotate.py). Non-blocking by
# default: a weak suite is recorded and ranked, not a halted batch.
# PIPELINE_GATE_BLOCKING=             # 1 to exit non-zero when B1 is below the minimum
# PIPELINE_MIN_KILL=0.90              # mutation-kill minimum
# Parallel languages in the executor (execution_manager_v3.py).
# NEW_COMPILER_LANG_PARALLELISM=5


# =============================================================================
# LLM / OpenRouter — global (see pipeline/Scripts/llm_client.py)
# =============================================================================

# Route through the Replit proxy gateway instead of calling OpenRouter directly.
# OPENROUTER_BASE_URL=https://open-router-gateway.replit.app/api/proxy

# Global model override for every purpose (per-purpose vars below win over this).
# OPENROUTER_MODEL=
# OPENAI_MODEL=

# CP-prep (TypeScript upload flow) model + optional per-tier model list.
# OPENROUTER_MODEL_CP_PREP=anthropic/claude-opus-4.8
# OPENROUTER_CP_PREP_MODEL_TIERS=

# Transport / streaming tunables.
# OPENAI_MAX_RETRIES=8
# OPENAI_MAX_TOKENS=                  # global completion-token cap override
# OPENAI_DISABLE_STREAMING=           # 1 to disable streaming
# OPENROUTER_DISABLE_GZIP=            # 1 to stop gzipping request bodies
# OPENROUTER_HEARTBEAT_SEC=15
# OPENROUTER_STREAM_RETRIES=3
# OPENROUTER_GATEWAY_403_RETRIES=3
# SSL_CERT_FILE=                      # custom CA bundle (Replit proxy TLS)

# Global LLM read timeout (seconds). Per-purpose overrides below.
# OPENAI_READ_TIMEOUT_SEC=

# Global reasoning effort for the "chat" purpose (descriptions, titles, etc.).
# OPENAI_REASONING_EFFORT=high

# NOTE: every per-purpose model/effort var below also accepts an OPENAI_-prefixed
# alias (e.g. OPENAI_MODEL_TESTCASES == OPENROUTER_MODEL_TESTCASES).


# =============================================================================
# LLM — testcase generation (per-difficulty; defaults live in llm_client.py)
#   Built-in defaults: model=anthropic/claude-opus-4.8 for all tiers;
#   reasoning effort easy=minimal, medium=medium, hard=high;
#   fallbacks openai/gpt-5.5, google/gemini-3.5-flash, anthropic/claude-sonnet-4.6.
#   Suffix a tier (_EASY|_MEDIUM|_HARD) to target one difficulty.
# =============================================================================

# OPENROUTER_MODEL_TESTCASES=         # pin the model for ALL tiers
# OPENROUTER_MODEL_TESTCASES_HARD=    # pin just one tier
# OPENAI_REASONING_EFFORT_TESTCASES=  # minimal|low|medium|high|xhigh (all tiers)
# OPENROUTER_FALLBACK_TESTCASES=      # comma-separated fallback models
# OPENROUTER_FALLBACK_EFFORTS_TESTCASES=   # model:effort pairs or CSV of efforts
# OPENAI_TESTCASES_READ_TIMEOUT_SEC=2700   # 45 min (matches run-route hard cap)
# TESTCASE_SCRIPT_TIMEOUT_SEC=        # timeout for running the generated script
# TESTCASE_SIZE_FIX_ROUNDS=           # size-diversity re-gen rounds (default 0 = off; set 1+ to re-enable)
# TESTCASE_TLE_LIMIT_SEC=4            # judge time limit TLE is verified against
# TESTCASE_GROUNDING_TIMEOUT_SEC=10   # per-run cap when validating against the solution
# TESTCASE_SKIP_GROUNDING=            # 1 to skip the grounding/repair pass
# OPENAI_BRUTE_FORCE_READ_TIMEOUT_SEC=900   # brute-force purpose LLM read timeout


# =============================================================================
# LLM — editorial / harden (optional)
# =============================================================================

# OPENAI_REASONING_EFFORT_EDITORIAL=  # unset = reasoning off
# OPENROUTER_FALLBACK_EFFORTS_EDITORIAL=
# OPENAI_EDITORIAL_READ_TIMEOUT_SEC=1800
# EDITORIAL_EXEC_PARALLELISM=
# EDITORIAL_EXEC_TLE_LIMIT=
# EDITORIAL_REASONING_MODE=
# OPENAI_REASONING_EFFORT_HARDEN=medium


# =============================================================================
# Test suite / benchmarking (optional)
# =============================================================================

# SUITE_MAX_ROUNDS=
# SUITE_MIN_KILL=
# SUITE_MAX_WORKERS=
# BENCHMARK_FUZZ_COUNT=
# BENCHMARK_RUN_TIMEOUT=
# BENCHMARK_STRESS_INPUT_CHARS=
# BENCHMARK_USE_COMPILER=
# BRUTE_MISMATCH_FATAL=
# EXEC_RESULT_IO_CAP=


# =============================================================================
# AWS / S3 — Python pipeline execution manager
#   Separate from the app object storage above: uploads compiler execution
#   assets. Reuses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION.
#   Loaded by pipeline/Scripts/project_env.py (also reads
#   pipeline/.env.execution_manager_v2 if present).
# =============================================================================

# S3_BUCKET=                          # pipeline bucket (NOTE: distinct from AWS_BUCKET_NAME)
# AWS_PROFILE=                        # use a named AWS profile instead of static keys
# SUPPRESS_S3_UPLOAD_LOGS=            # 1 to quiet S3 upload logs


# =============================================================================
# New compiler service
#   Preferred location: pipeline/.env.new_compiler.local (gitignored).
#   See pipeline/.env.new_compiler.local.example.
# =============================================================================

# NEW_COMPILER_URL=http://localhost:8000
# NEW_COMPILER_POLL_SECS=1.0
# NEW_COMPILER_MAX_POLLS=300
# NEW_COMPILER_SUBMIT_TIMEOUT=120
# NEW_COMPILER_POLL_TIMEOUT=
# NEW_COMPILER_POLL_MAX_ERRORS=
# NEW_COMPILER_INLINE_ONLY=
# NEW_COMPILER_S3_THRESHOLD_BYTES=
# NEW_COMPILER_FORCE_S3_INPUTS=
# NEW_COMPILER_FORCE_S3_OUTPUTS=
# NEW_COMPILER_CAPTURE_API=
# NEW_COMPILER_CAPTURE_DIR=pipeline/temp_compiler_sandbox/captures
# NEW_COMPILER_QUIET=


# =============================================================================
# Loadings — NKB content loading (beta only; src/lib/loadings/*)
# =============================================================================
# Only needed to push prepared questions into the NKB beta platform. The whole
# section can stay unset if you never run a load; the UI lists what is missing
# before starting (missingLoadingsConfig in src/lib/loadings/config.ts).

# The "new unit" sheet template that every load is copied from. REQUIRED for loads —
# there is no default, and a load fails without a valid spreadsheet URL.
CODING_QUESTIONS_LOADING_SHEET_URL=

# Google service account used for the Sheets/Drive calls. Either inline the key JSON
# (keeps every secret in this one file) or point at a key file — inline wins if both
# are set. Single quotes are REQUIRED around the JSON: with double quotes the loader
# expands the private key's \n escapes into real newlines and JSON.parse then fails.
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Extra people each generated sheet is shared with, comma-separated. NKB's own
# reader account is always added in code — SHEET_LOADING cannot read a copy
# that is not shared with it — so this is only for humans who want to look.
# GOOGLE_SHEET_SHARE_EMAILS=

# NKB beta backend + Django admin (admin URL defaults to <base>/admin/).
# NKB_BETA_API_BASE_URL=https://nkb-backend-ccbp-beta.earlywave.in
# DJANGO_ADMIN_URL=

# Load-data API user (username defaults to content_loader).
# NKB_LOAD_DATA_USERNAME=content_loader
NKB_LOAD_DATA_PASSWORD=

# Django admin login — the unit/question-set pages are scraped through it.
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_PASSWORD=

# Registry sheet of question_set_id | unit_name, shared with the Loadings app.
# Has a working default; override only to point at another sheet.
# CODING_PRACTICE_SET_SHEET_ID=

# Parent TOPIC resource the auto-created "Coding Testing N" units hang off. Unset
# means no new testing unit can be minted once the existing sets are full.
# NKB_TESTING_PARENT_RESOURCE=

# Zip upload for the content-loading bucket. Falls back to the AWS_* credentials
# above; set these only when that key lacks PutObject on the prefix.
# NKB_ZIP_AWS_ACCESS_KEY_ID=
# NKB_ZIP_AWS_SECRET_ACCESS_KEY=
# NKB_ZIP_AWS_REGION=ap-south-1
# NKB_ZIP_BUCKET=new-assets.ccbp.in
# NKB_ZIP_KEY_PREFIX=frontend/ccbp_beta/content_loading/uploads/
# NKB_ZIP_PUBLIC_URL_BASE=https://new-assets.ccbp.in/frontend/ccbp_beta/content_loading/uploads/


###############################################################################
# Set automatically at runtime — DO NOT configure by hand.
# The Next.js run route injects these per pipeline invocation, and the platform
# provides the REPLIT_*/NODE_ENV vars:
#   INTERNAL_API_SECRET, PIPELINE_RUN_ID, PIPELINE_STEP_ID, PIPELINE_PROBLEM_ID,
#   PIPELINE_USER_ID, PIPELINE_BASE_DIR, PIPELINE_MODE, PIPELINE_QUESTION_TYPE,
#   PIPELINE_OWNER_DIFFICULTY, PIPELINE_OWNER_SCORE, PIPELINE_OWNER_TITLE,
#   PIPELINE_REFINE_NOTE, REPLIT_DEPLOYMENT, REPLIT_DOMAINS, REPLIT_DEV_DOMAIN,
#   NODE_ENV.
###############################################################################
