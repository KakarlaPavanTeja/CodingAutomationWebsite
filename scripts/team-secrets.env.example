# Shared team secrets for local setup.
# 1. Copy:  cp scripts/team-secrets.env.example scripts/team-secrets.env
# 2. Fill in values from your team lead
# 3. NEVER commit scripts/team-secrets.env (gitignored)

OPENROUTER_API_KEY=sk-or-v1-...
ADMIN_SECRET_KEY=your-admin-secret
CRON_SECRET=your-64-char-hex-secret

# Optional
# RESEND_API_KEY=re_...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# APP_URL=http://localhost:5001

# Do NOT set DATABASE_URL here — local setup runs Postgres in Docker and writes
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codingautomation to .env.local
