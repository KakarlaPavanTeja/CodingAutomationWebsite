# Shared team secrets for local setup.
# 1. Copy:  cp scripts/team-secrets.env.example scripts/team-secrets.env
# 2. Fill in values from your team lead
# 3. NEVER commit scripts/team-secrets.env (gitignored)

OPENROUTER_API_KEY=sk-or-v1-...
ADMIN_SECRET_KEY=your-admin-secret
CRON_SECRET=your-64-char-hex-secret

# Shared cloud database (REQUIRED). Ask your team lead for the team's Neon
# connection string. The app connects directly to this shared DB — no local
# Postgres / Docker is used.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional
# RESEND_API_KEY=re_...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# APP_URL=http://localhost:5001
